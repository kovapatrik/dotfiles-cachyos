#!/bin/bash
# Sets up the system side of the couch gaming PC. Safe to re-run.
# Re-runs automatically when any of these change:
# packages.txt: {{ include "packages.txt" | sha256sum }}
# system/:      {{ range glob (joinPath .chezmoi.sourceDir "system/**") }}{{ if not (stat .).isDir }}{{ include . | sha256sum | trunc 8 }} {{ end }}{{ end }}
set -euo pipefail

src={{ .chezmoi.sourceDir | quote }}

# put MODE PATH: copy system/PATH to /PATH
put() {
    sudo install -Dm "$1" "$src/system$2" "$2"
}

echo "==> Packages"
grep -v '^\s*$' "$src/packages.txt" | sudo pacman -S --needed --noconfirm -
# Hermes streaming host: prebuilt package from https://github.com/MrOz59/Hermes/releases,
# only when missing - updates are done by hand, so a newer installed version is kept
if ! pacman -Q hermes-streaming >/dev/null 2>&1; then
    # Downloaded first: given a URL, pacman also fetches a .sig, which the release doesn't have (404)
    pkg_dir="$(mktemp -d)"
    curl -fL --output-dir "$pkg_dir" -O \
        https://github.com/MrOz59/Hermes/releases/download/v0.6.0/hermes-streaming-0.6.0-1-x86_64.pkg.tar.zst
    sudo pacman -U --needed --noconfirm "$pkg_dir"/*.pkg.tar.zst
    rm -rf "$pkg_dir"
fi
# Hermes-KMS virtual display driver: built from source, only when missing
if ! pacman -Q hermes-kms-dkms-git hermes-kms-seatd-git >/dev/null 2>&1; then
    build_dir="$(mktemp -d)"
    git clone --depth 1 https://github.com/MrOz59/Hermes-KMS.git "$build_dir"
    (cd "$build_dir" && makepkg -si --needed --noconfirm)
    rm -rf "$build_dir"
fi

echo "==> Hermes"
put 644 /etc/modprobe.d/hermes-evdi.conf
systemctl --user enable hermes.service

echo "==> pc-power SSH user (Homebridge + Home Assistant) + TV webhook"
if ! getent passwd pc-power >/dev/null; then
    sudo useradd --system --create-home --home-dir /var/lib/pc-power --shell /bin/sh pc-power
fi
sudo install -d -m 700 -o pc-power -g pc-power /var/lib/pc-power/.ssh
# Keys of whichever of Homebridge / Home Assistant were given one (both may be set)
{
    :
{{- range $key := list .homebridge.pcPowerKey .homeassistant.pcPowerKey }}
{{-   if $key }}
    echo 'restrict,command="/usr/local/bin/pc-power" {{ $key }}'
{{-   end }}
{{- end }}
} | sudo install -m 600 -o pc-power -g pc-power /dev/stdin /var/lib/pc-power/.ssh/authorized_keys
put 755 /usr/local/bin/pc-power
put 755 /usr/local/bin/pc-tv-notify
sudo visudo -cf "$src/system/etc/sudoers.d/pc-power"   # a broken sudoers file would lock out sudo
put 440 /etc/sudoers.d/pc-power
sudo install -Dm 644 /dev/stdin /etc/pc-tv.conf <<'EOF'
{{ includeTemplate "pc-tv.conf" . -}}
EOF
put 644 /etc/ssh/sshd_config.d/10-no-password.conf
put 644 /etc/systemd/system/pc-tv-boot.service
put 644 /etc/systemd/system/pc-tv-resume.service
put 644 /etc/systemd/system/pc-tv-suspend.service

echo "==> RGB off at boot"
put 755 /usr/local/bin/rgb-off
put 644 /etc/systemd/system/rgb-off.service

sudo systemctl daemon-reload
sudo systemctl enable pc-tv-boot.service pc-tv-resume.service pc-tv-suspend.service rgb-off.service
sudo systemctl enable --now sshd.service tailscaled.service
sudo systemctl reload sshd.service

echo "==> Wake-on-LAN and Bluetooth controller wakeup"
nmcli -t -f NAME,TYPE connection show | while IFS=: read -r name type; do
    if [[ "$type" == "802-3-ethernet" ]]; then
        sudo nmcli connection modify "$name" 802-3-ethernet.wake-on-lan magic
    fi
done
put 644 /etc/udev/rules.d/10-bluetooth-wakeup.rules
sudo udevadm control --reload

echo "==> Gamescope -> Plasma keybind (Ctrl+Alt+D)"
put 644 /etc/xbindkeysrc

echo "==> Firewall"
lan={{ .lanSubnet | quote }}
sudo ufw allow in on tailscale0
sudo ufw allow 41641/udp
sudo ufw allow from "$lan" to any port 47984,47989,48010 proto tcp   # Hermes streaming
sudo ufw allow from "$lan" to any port 47998:48010 proto udp         # Hermes streaming
sudo ufw allow from "$lan" to any port 22 proto tcp                  # SSH (pc-power: Homebridge / Home Assistant)
sudo ufw --force enable
sudo systemctl enable ufw.service

if ! tailscale status >/dev/null 2>&1; then
    echo "Tailscale is not logged in. Run: sudo tailscale up --login-server=<headscale URL> --ssh"
fi
