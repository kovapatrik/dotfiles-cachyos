    },
    {
      "allow-client-commands": false,
      "image-path": "virtual_desktop.png",
      "name": "Desktop (Virtual Display)",
      "uuid": "BB9BEBE2-5D26-A422-1408-BC8BBE826AD7",
      "virtual-display": true,
      "virtual-display-layout": "exclusive"
    },
    {
      "detached": [
        "setsid steam steam://open/bigpicture"
      ],
      "image-path": "steam.png",
      "name": "Steam Big Picture",
      "prep-cmd": [
        {
          "do": "",
          "undo": "setsid steam steam://close/bigpicture"
        }
      ],
      "uuid": "86BC3531-9A07-530E-CA85-0CE57F417CB3"
    },
    {
      "auto-detach": false,
      "cmd": "hermes-gamescope-launch",
      "exit-timeout": 5,
      "image-path": "steam.png",
      "name": "Gamescope Steam Session",
      "scale-factor": 100,
      "uuid": "1B340A15-69B0-D22E-8B1A-7C8325F37DD8",
      "virtual-display": true,
      "virtual-display-layout": "mirror",
      "wait-all": true,
      "prep-cmd": [
        {
          "do": "bash -c 'steam -shutdown 2>/dev/null || true; for i in $(seq 1 30); do pgrep -x steam >/dev/null 2>&1 || break; sleep 1; done; sleep 3'",
          "undo": ""
        }
      ]
    },
    {
      "allow-client-commands": false,
      "image-path": "desktop.png",
      "name": "Switch to Desktop",
      "prep-cmd": [
        {
          "do": "steamos-session-select plasma",
          "undo": ""
        }
      ],
      "uuid": "6420AE90-7642-120B-FC15-9345019FF091"
    }
  ],
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  },
  "version": 3
}