[Unit]
Description=TV on at boot, TV off at shutdown (Home Assistant or Homebridge, per tvTarget)
Wants=network-online.target
After=network-online.target

[Service]
# exec, not oneshot: the wake retries must not hold up boot (and the gamescope session)
Type=exec
RemainAfterExit=yes
ExecStart=/usr/local/bin/pc-tv-notify wake
ExecStop=/usr/local/bin/pc-tv-notify sleep

[Install]
WantedBy=multi-user.target
